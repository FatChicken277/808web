---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>808 FEST - Música, Arte y Under</title>
  </head>
  <body class="bg-black">
    <!-- Halation Wrapper -->
    <div class="halation-wrapper">
      <slot />
    </div>

    <!-- Animated Film Grain -->
    <div class="film-grain"></div>

    <!-- Custom Cursor -->
    <div id="custom-cursor"></div>

    <script>
      const cursor = document.getElementById("custom-cursor");

      if (cursor) {
        document.addEventListener("mousemove", (e) => {
          const target = e.target as HTMLElement;

          cursor.style.left = e.clientX + "px";
          cursor.style.top = e.clientY + "px";

          // Check if we are over a native cursor area
          const requiresNative = target.closest(
            "iframe, .overflow-x-auto, [data-native-cursor]",
          );
          if (requiresNative) {
            document.body.classList.add("force-native-cursor");
            cursor.style.opacity = "0";
          } else {
            document.body.classList.remove("force-native-cursor");
            cursor.style.opacity = "1";
          }
        });

        // Event delegation for hover states
        document.addEventListener("mouseover", (e) => {
          const target = e.target as HTMLElement;
          const isClickable = target.closest(
            'a, button, [role="button"], input, select, .cursor-pointer',
          );
          if (isClickable) {
            cursor.classList.add("cursor-hover");
          } else {
            cursor.classList.remove("cursor-hover");
          }
        });

        document.addEventListener("mouseout", (e) => {
          if (!e.relatedTarget) cursor.style.opacity = "0";
        });
        document.addEventListener("mouseenter", () => {
          cursor.style.opacity = "1";
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    body:not(.force-native-cursor) * {
      cursor: none !important;
    }
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
  }

  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    border: 2px solid white;
    border-radius: 50%;
    pointer-events: none;
    z-index: 100000;
    transform: translate(-50%, -50%);
    transition:
      width 0.2s ease,
      height 0.2s ease,
      background-color 0.2s ease;
    mix-blend-mode: difference;
  }

  @media (hover: none), (pointer: coarse) {
    #custom-cursor {
      display: none !important;
    }
  }

  #custom-cursor.cursor-hover {
    width: 24px;
    height: 24px;
    background-color: white;
    opacity: 1;
  }

  .halation-wrapper {
    /* CSS-only Halation and Film Look */
    filter: drop-shadow(0 0 12px rgba(255, 60, 0, 0.4)) contrast(1.05)
      saturate(1.4) brightness(0.95);
    min-height: 100vh;
  }

  @keyframes grain-animation {
    0%,
    100% {
      transform: translate(0, 0);
    }
    10% {
      transform: translate(-5%, -5%);
    }
    20% {
      transform: translate(-10%, 5%);
    }
    30% {
      transform: translate(5%, -10%);
    }
    40% {
      transform: translate(-5%, 15%);
    }
    50% {
      transform: translate(-10%, 5%);
    }
    60% {
      transform: translate(15%, 0);
    }
    70% {
      transform: translate(0, 10%);
    }
    80% {
      transform: translate(-15%, 0);
    }
    90% {
      transform: translate(10%, 5%);
    }
  }

  .film-grain {
    position: fixed;
    top: -50%;
    left: -50%;
    right: -50%;
    bottom: -50%;
    width: 200%;
    height: 200%;
    pointer-events: none;
    z-index: 9999;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 650px 650px;
    opacity: 0.1;
    mix-blend-mode: hard-light;
    animation: grain-animation 0.4s steps(4) infinite;
  }
</style>
