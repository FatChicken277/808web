---
import "../styles/global.css";
import Scanner from '../components/Scanner';
import { ADMIN_COOKIE, isValidSessionToken } from "../lib/adminAuth";
// @ts-ignore
import { env } from "cloudflare:workers";

const configuredPassword: string = (env as any)?.ADMIN_PASSWORD || "";
let authed = false;

if (!configuredPassword) {
  authed = import.meta.env.DEV;
} else {
  const cookieValue = Astro.cookies.get(ADMIN_COOKIE)?.value;
  authed = await isValidSessionToken(cookieValue, configuredPassword);
}
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="808 Check-in" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>808 Fest - Check-in</title>
</head>
<body class="bg-black">
    <div class="admin-ambient" aria-hidden="true">
        <div class="glow glow-green"></div>
        <div class="glow glow-purple"></div>
    </div>

    {authed ? (
      <Scanner client:only="react" />
    ) : (
      <main class="relative z-10 flex min-h-[100dvh] items-center justify-center p-4 font-sans text-white">
        <div class="w-full max-w-sm border border-white/15 bg-zinc-950/80 p-8 shadow-2xl backdrop-blur-sm">
          <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.35em] text-white/40">808 Fest</p>
          <h1 class="mb-1 text-2xl font-bold uppercase tracking-tighter text-white">Check-in</h1>
          <p class="mb-6 text-xs uppercase tracking-widest text-white/40">Acceso restringido</p>

          <div id="login-error" class="mb-4 hidden border border-red-500 bg-red-500/20 p-3 text-sm text-red-200"></div>

          <form id="scan-login-form" class="flex flex-col gap-4">
            <div>
              <label class="mb-1 block text-xs font-bold uppercase tracking-widest text-white/70" for="password">Clave de acceso</label>
              <input
                required
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                class="w-full border border-white/10 bg-white/5 p-2 text-white focus:border-white focus:outline-none"
              />
            </div>
            <button
              type="submit"
              id="login-submit"
              class="mt-2 bg-[#39FF14] p-3 font-bold uppercase tracking-widest text-black transition-colors hover:bg-white disabled:opacity-50"
            >
              Entrar al scanner
            </button>
          </form>
        </div>
      </main>
    )}

    <div class="film-grain" aria-hidden="true"></div>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", async () => {
          try {
            const reg = await navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" });
            await reg.update();
            if (reg.waiting) reg.waiting.postMessage({ type: "SKIP_WAITING" });
          } catch {}
        });
      }

      const form = document.getElementById("scan-login-form") as HTMLFormElement | null;
      if (form) {
        const errorBox = document.getElementById("login-error") as HTMLDivElement;
        const submit = document.getElementById("login-submit") as HTMLButtonElement;
        const passwordInput = document.getElementById("password") as HTMLInputElement;

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          errorBox.classList.add("hidden");
          submit.disabled = true;
          submit.textContent = "Verificando...";
          try {
            const res = await fetch("/api/admin/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password: passwordInput.value }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.success) {
              // Nos quedamos en /scan
              window.location.href = "/scan";
              return;
            }
            errorBox.textContent = data.error || "No se pudo iniciar sesión.";
            errorBox.classList.remove("hidden");
          } catch {
            errorBox.textContent = "Error de conexión.";
            errorBox.classList.remove("hidden");
          } finally {
            submit.disabled = false;
            submit.textContent = "Entrar al scanner";
          }
        });
      }
    </script>
</body>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: #000;
    overflow: hidden;
  }

  .admin-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .admin-ambient .glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(120px);
    opacity: 0.18;
  }

  .admin-ambient .glow-green {
    top: -10%;
    right: -5%;
    width: 45vw;
    height: 45vw;
    background: #39ff14;
  }

  .admin-ambient .glow-purple {
    bottom: -15%;
    left: -10%;
    width: 50vw;
    height: 50vw;
    background: #9333ea;
    opacity: 0.22;
  }

  @keyframes grain-animation {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-5%, -5%); }
    20% { transform: translate(-10%, 5%); }
    30% { transform: translate(5%, -10%); }
    40% { transform: translate(-5%, 15%); }
    50% { transform: translate(-10%, 5%); }
    60% { transform: translate(15%, 0); }
    70% { transform: translate(0, 10%); }
    80% { transform: translate(-15%, 0); }
    90% { transform: translate(10%, 5%); }
  }

  .film-grain {
    position: fixed;
    top: -50%;
    left: -50%;
    right: -50%;
    bottom: -50%;
    width: 200%;
    height: 200%;
    pointer-events: none;
    z-index: 9999;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 650px 650px;
    opacity: 0.06;
    mix-blend-mode: hard-light;
    animation: grain-animation 0.4s steps(4) infinite;
  }

  /* Estilos del scanner viven en el componente; aquí no forzamos layout del decoder */
</style>
</html>
