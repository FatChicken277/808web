---
import "../styles/global.css";
import Scanner from '../components/Scanner';
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>808 Fest - Check-in</title>
</head>
<body class="bg-black">
    <div class="admin-ambient" aria-hidden="true">
        <div class="glow glow-green"></div>
        <div class="glow glow-purple"></div>
    </div>

    <Scanner client:only="react" />

    <div class="film-grain" aria-hidden="true"></div>
</body>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: #000;
    overflow: hidden;
  }

  .admin-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .admin-ambient .glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(120px);
    opacity: 0.18;
  }

  .admin-ambient .glow-green {
    top: -10%;
    right: -5%;
    width: 45vw;
    height: 45vw;
    background: #39ff14;
  }

  .admin-ambient .glow-purple {
    bottom: -15%;
    left: -10%;
    width: 50vw;
    height: 50vw;
    background: #9333ea;
    opacity: 0.22;
  }

  @keyframes grain-animation {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-5%, -5%); }
    20% { transform: translate(-10%, 5%); }
    30% { transform: translate(5%, -10%); }
    40% { transform: translate(-5%, 15%); }
    50% { transform: translate(-10%, 5%); }
    60% { transform: translate(15%, 0); }
    70% { transform: translate(0, 10%); }
    80% { transform: translate(-15%, 0); }
    90% { transform: translate(10%, 5%); }
  }

  .film-grain {
    position: fixed;
    top: -50%;
    left: -50%;
    right: -50%;
    bottom: -50%;
    width: 200%;
    height: 200%;
    pointer-events: none;
    z-index: 9999;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 650px 650px;
    opacity: 0.06;
    mix-blend-mode: hard-light;
    animation: grain-animation 0.4s steps(4) infinite;
  }

  /* Force html5-qrcode video to fill the viewport */
  #qr-reader {
    border: none !important;
    width: 100% !important;
    height: 100% !important;
    position: absolute !important;
    inset: 0 !important;
    overflow: hidden !important;
    background: #000 !important;
  }

  #qr-reader__dashboard_section,
  #qr-reader__header_message,
  #qr-reader__scan_region > img,
  #qr-shaded-region {
    display: none !important;
  }

  #qr-reader__scan_region {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    display: block !important;
    overflow: hidden !important;
  }

  #qr-reader video,
  #qr-reader canvas {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    border: none !important;
    border-radius: 0 !important;
    transform: none !important;
  }
</style>
</html>
