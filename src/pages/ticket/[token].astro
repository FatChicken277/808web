---
import { getDb } from '../../db';
import { tickets } from '../../db/schema';
import { eq } from 'drizzle-orm';
// @ts-ignore
import { env } from 'cloudflare:workers';

const { token } = Astro.params;

let ticket: any = null;
let errorMsg = '';

if (!token) {
  errorMsg = 'Token no proporcionado.';
} else {
  try {
    const db = getDb((env as any) || process.env);
    const result = await db.select().from(tickets).where(eq(tickets.qr_token, token)).limit(1);
    if (result.length === 0) {
      errorMsg = 'Ticket no encontrado.';
    } else {
      ticket = result[0];
    }
  } catch (e: any) {
    errorMsg = 'Error al buscar el ticket.';
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{ticket ? `Ticket de ${ticket.full_name} — 808 FEST` : '808 FEST — Ticket'}</title>
    <meta name="description" content="Tu ticket digital para 808 Fest. Muestra este QR en la entrada del evento." />
  </head>
  <body>
    <div class="ticket-page">
      {errorMsg ? (
        <div class="ticket-container">
          <img src="/logos/808.png" alt="808 FEST" class="logo" />
          <h1 class="title error-color">TICKET NO ENCONTRADO</h1>
          <p class="subtitle">{errorMsg}</p>
          <p class="subtitle">El ticket que buscas no existe o el enlace es inválido.</p>
          <a href="/" class="link">← Volver al inicio</a>
        </div>
      ) : (
        <div class="ticket-container">
          <img src="/logos/808.png" alt="808 FEST" class="logo" />
          <h2 class="greeting">HOLA {ticket.full_name.toUpperCase()}, AQUÍ ESTÁ TU TICKET</h2>
          <p class="subtitle">Muestra este código QR en la entrada del evento.</p>
          <div class="qr-box">
            <img
              src={`/api/qr/${token}`}
              alt="Código QR del ticket"
              width="220"
              height="220"
              loading="eager"
            />
          </div>
          {ticket.attended && (
            <div class="attended-badge">✓ YA INGRESÓ AL EVENTO</div>
          )}
          <p class="token-text">Token: {token}</p>
        </div>
      )}
    </div>

    <!-- Animated Film Grain -->
    <div class="film-grain"></div>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #000;
        color: #fff;
        font-family: monospace;
        min-height: 100vh;
      }

      .ticket-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
      }

      /* ── Container (mirrors email template) ── */
      .ticket-container {
        text-align: center;
        max-width: 480px;
        width: 100%;
        padding: 40px 24px;
        animation: fadeIn 0.5s ease-out;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* ── Logo ── */
      .logo {
        width: 160px;
        height: auto;
        margin-bottom: 28px;
        filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.6));
      }

      /* ── Typography ── */
      .greeting {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        line-height: 1.4;
      }

      .title {
        font-size: 20px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 12px;
      }

      .error-color {
        color: #ff3c3c;
      }

      .subtitle {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 4px;
      }

      /* ── QR Box (matches email white box) ── */
      .qr-box {
        background: white;
        padding: 20px;
        display: inline-block;
        margin-top: 24px;
        border-radius: 10px;
      }

      .qr-box img {
        display: block;
        width: 220px;
        height: 220px;
        image-rendering: pixelated;
      }

      /* ── Attended Badge ── */
      .attended-badge {
        margin-top: 24px;
        background: rgba(57, 255, 20, 0.1);
        border: 1px solid rgba(57, 255, 20, 0.3);
        display: inline-block;
        padding: 10px 24px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #39FF14;
      }

      /* ── Token ── */
      .token-text {
        margin-top: 40px;
        opacity: 0.3;
        font-size: 12px;
        word-break: break-all;
      }

      /* ── Back Link ── */
      .link {
        display: inline-block;
        margin-top: 24px;
        color: #39FF14;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: opacity 0.2s ease;
      }

      .link:hover {
        opacity: 0.7;
      }

      /* ── Responsive ── */
      @media (max-width: 480px) {
        .logo { width: 120px; }
        .greeting { font-size: 15px; }
        .qr-box img { width: 180px; height: 180px; }
      }

      /* ── Film Grain ── */
      @keyframes grain-animation {
        0%, 100% { transform: translate(0, 0); }
        10% { transform: translate(-5%, -5%); }
        20% { transform: translate(-10%, 5%); }
        30% { transform: translate(5%, -10%); }
        40% { transform: translate(-5%, 15%); }
        50% { transform: translate(-10%, 5%); }
        60% { transform: translate(15%, 0); }
        70% { transform: translate(0, 10%); }
        80% { transform: translate(-15%, 0); }
        90% { transform: translate(10%, 5%); }
      }

      .film-grain {
        position: fixed;
        top: -50%; left: -50%; right: -50%; bottom: -50%;
        width: 200%; height: 200%;
        pointer-events: none;
        z-index: 9999;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 650px 650px;
        opacity: 0.1;
        mix-blend-mode: hard-light;
        animation: grain-animation 0.4s steps(4) infinite;
      }
    </style>
  </body>
</html>
