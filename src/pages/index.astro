---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import GridSection from '../components/GridSection';
import Marquee from '../components/Marquee';
import ArtistsSection from '../components/ArtistsSection';
import VideoSection from '../components/VideoSection';
import MapSection from '../components/MapSection';
import Footer from '../components/Footer';
import { getCollection } from 'astro:content';

const artistsEntries = await getCollection('artists');
const artistsData = artistsEntries.map((entry: any) => entry.data);

const caosEntries = await getCollection('caos');
const caosData = caosEntries.map((entry: any) => entry.data);
---

<Layout>
  <Hero client:load />
  <div id="delayed-content" class="hidden">
    <Marquee />
    <ArtistsSection client:load artists={artistsData} />
    <VideoSection client:load />
    <GridSection posts={caosData} />
    <MapSection />
    <Footer />
  </div>
</Layout>
